# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saathi_voice
DB_USER=postgres
DB_PASSWORD=your_password

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice IDs (customize for each role)
VOICE_ID_DAUGHTER=your_voice_id_for_daughter
VOICE_ID_SON=your_voice_id_for_son
VOICE_ID_MOTHER=your_voice_id_for_mother
VOICE_ID_FATHER=your_voice_id_for_father
VOICE_ID_HUSBAND=your_voice_id_for_husband
VOICE_ID_WIFE=your_voice_id_for_wife
VOICE_ID_FRIEND=your_voice_id_for_friend
VOICE_ID_GRANDFATHER=your_voice_id_for_grandfather
VOICE_ID_GRANDMOTHER=your_voice_id_for_grandmother

# Security
JWT_SECRET=your_jwt_secret_here

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
